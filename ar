#!/bin/sh
# Run operations and show advisory reflection cues; write research notes in STATE.md.
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
export GRAPH_AGENT_ROOT="$root"
export PYTHONPATH="$root/development${PYTHONPATH:+:$PYTHONPATH}"
unset GRAPH_AGENT_MACHINE
cd "$root"
exec python3 -m harness.run_control "$@"
